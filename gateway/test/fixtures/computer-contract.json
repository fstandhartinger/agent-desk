{
 "contract": 1,
 "note": "The exact messages between the Desk gateway (agent-desk) and the Screen Agent app. The same file lives in both repos (agent-desk gateway/test/fixtures/computer-contract.json, screen-agent testdata/computer-contract.json). Core tests parse commands and build results from it, the gateway tests produce commands and validate results against it. Change it in BOTH repos or a test fails.",
 "ids": {
  "command": "^c[0-9a-f]{16}$",
  "run": "^r[0-9a-f]{16}$"
 },
 "timing": {
  "beatMs": 5000,
  "deadAfterMs": 15000,
  "hotkeySecondResultMs": 120000
 },
 "scope": {
  "post": "/api/device/computer",
  "body": {
   "enabled": true
  },
  "repostEveryMs": 120000,
  "note": "the gateway keeps the scope in memory: re-posted every 2 min, after a failed poll and at every new session"
 },
 "routes": {
  "poll": "GET /api/device/session/:sid/commands -> {fresh:false, computer:<command>}",
  "result": "POST /api/device/session/:sid/computer/:commandId/result",
  "beat": "POST /api/device/session/:sid/computer/beat",
  "trace": "POST /api/device/session/:sid/trace and /api/device/log (types computer.*)"
 },
