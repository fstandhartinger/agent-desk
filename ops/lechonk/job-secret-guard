#!/bin/bash
# job-secret-guard — refuse to start an agent job on LeChonk without its secrets (reliability N56, 3 Nov 2026).
#
# On LeChonk a job gets its secrets (GH_TOKEN, OPENROUTER_API_KEY, ELEVENLABS_API_KEY, ...) only through ~/bin/lechonk-job on
# Sandy: it streams them into a 0600 tmpfs file that the job unit sources and deletes, and it sets LECHONK_REMOTE=1. A job
# started on LeChonk itself (e.g. `job-start` from a desk session) got none of them and failed late (#41594, #41608).
#
# usage: job-secret-guard <jobdir> [--no-secrets]
# Checks ITS OWN environment, so call it with exactly the environment the job's session will start with
# (job-start does `env -i <unit env> job-secret-guard ...`). Exit 0 = may start, exit 2 = refused (reason on stderr).
#   - host other than lechonk: always 0 (Sandy jobs read the secret files themselves)
#   - secret-injection metadata present: LECHONK_REMOTE=1 (only lechonk-job sets it) and at least one handed-over secret
#   - declared: --no-secrets or a PROMPT.md line "SECRETS: none" (the job needs no API keys)
# Only variable NAMES and counts are ever printed, never values. JOB_SECRET_GUARD_HOST overrides hostname (fixtures only).
set -uo pipefail
J="${1:-}"; DECL="${2:-}"
[ -n "$J" ] || { echo "usage: job-secret-guard <jobdir> [--no-secrets]" >&2; exit 2; }
HOSTNAME_NOW="${JOB_SECRET_GUARD_HOST:-$(hostname -s)}"
[ "$HOSTNAME_NOW" = lechonk ] || exit 0
[ "$DECL" = --no-secrets ] && { echo "job-secret-guard: $(basename "$J") starts without secrets (--no-secrets)" >&2; exit 0; }
if grep -qE '^SECRETS: *none *$' "$J/PROMPT.md" 2>/dev/null; then
  echo "job-secret-guard: $(basename "$J") starts without secrets (PROMPT.md: SECRETS: none)" >&2; exit 0
fi
# Names lechonk-job-secrets always hands over (GH_TOKEN is derived from GITHUB_PAT_2 when missing).
CANARY=(GH_TOKEN OPENROUTER_API_KEY ELEVENLABS_API_KEY CHUTES_API_KEY)
HAVE=0; for v in "${CANARY[@]}"; do [ -n "${!v:-}" ] && HAVE=$((HAVE + 1)); done
if [ "${LECHONK_REMOTE:-}" = 1 ] && [ "$HAVE" -ge 1 ]; then exit 0; fi
if [ "${LECHONK_REMOTE:-}" = 1 ]; then
  WHY="lechonk-job started it but handed over no secrets (0 of ${CANARY[*]})"
else
  WHY="it was started on LeChonk directly, not through lechonk-job, so it gets no secrets (0 of ${CANARY[*]} would be set)"
fi
cat >&2 <<MSG
job-secret-guard: REFUSED $(basename "$J"): $WHY.
  Nothing was started. Start it so lechonk-job hands over the keys:
  - from Sandy: ~/bin/job-start <job> (the folder must exist on Sandy; it runs on LeChonk when eligible),
  - from the Agent Desk / Screen Agent: the start_agent_job voice tool (Sandy bridge job.start),
  - from a LeChonk job or desk session: ask @cos-deputy-opus on the board with the full PROMPT.md text.
  If the job needs no API keys, add the line "SECRETS: none" to PROMPT.md or pass --no-secrets.
MSG
exit 2
